# Copy this to .env and fill in your real Neon connection string.
# NEVER commit the real .env file to git.
DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require

# Optional: max connections in the app's local pool (keep this modest --
# Neon's free/low tiers cap direct connections; use Neon's pooled/"-pooler"
# endpoint in DATABASE_URL if you're deploying the API, not the direct one).
PG_POOL_MAX=10
